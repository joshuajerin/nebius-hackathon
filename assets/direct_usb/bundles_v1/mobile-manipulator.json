{
  "name": "factory-sre/mobile-manipulator",
  "version": "0.1.0",
  "runtime": "isaac-sim-6.0.1",
  "physics_engine": "physx",
  "loader": "factory_sre.sim.asset_bundles_v1:load_bundle",
  "bundle_id": "mobile_manipulator",
  "default_prim_path": "/World/MobileManipulator",
  "components": {
    "go2": "/Isaac/Samples/Policies/go2/go2.usda",
    "go2_policy": "/Isaac/Samples/Policies/go2/physx_policy.pt",
    "go2_policy_env": "/Isaac/Samples/Policies/go2/physx_env.yaml",
    "so101": "so101_antioch@1.3.2",
    "d455": "/Isaac/Sensors/RealSense/D455/rsd455.usd",
    "nanoscan3": "/Isaac/Sensors/SICK/nanoScan3/SICK_nanoScan3.usd",
    "wrist_camera": "UsdGeom.Camera",
    "mount": "prototype-authored",
    "usb_tool": "prototype-authored"
  },
  "stock_acquisition": "reference_from_isaac_asset_root",
  "repackage_stock_files": false,
  "deployment_ready": false,
  "physical_gates": [
    "measured Go2-to-SO101 mount CAD, mass, and inertia",
    "measured wrist-camera transform and calibrated intrinsics",
    "measured compliant USB tool and cable geometry"
  ]
}

